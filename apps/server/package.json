{
  "name": "@shillex/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/cli.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "agents:migrate": "tsx --env-file-if-exists=../../.env src/agents/migrate-cli.ts",
    "world:spike": "tsx --env-file-if-exists=../../.env scripts/world-spike.ts",
    "world:smoke": "tsx --env-file-if-exists=../../.env scripts/chain-smoke.ts",
    "world": "tsx --env-file-if-exists=../../.env src/world/cli.ts",
    "world:seed": "npm run world -- seed",
    "world:treasury": "npm run world -- treasury",
    "world:launchpad": "npm run world -- launchpad",
    "world:fund": "npm run world -- fund",
    "mainnet:season": "tsx --env-file-if-exists=../../.env src/ledger/season-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.5",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@node-rs/argon2": "2.2.2",
    "@resvg/resvg-js": "2.6.2",
    "@shillex/shared": "*",
    "@solana/spl-token": "0.4.14",
    "@solana/wallet-standard-util": "1.1.4",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "bs58": "6.0.0",
    "dejavu-fonts-ttf": "2.37.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "ulidx": "2.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
