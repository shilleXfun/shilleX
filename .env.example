# Leave unset to use the embedded PGlite database in ./data/pglite
DATABASE_URL=
SESSION_SECRET=change-me
PORT=3000
PUBLIC_URL=http://localhost:5173
# Mainnet RPC for real token lookups only; the agents never use it (see DEVNET_RPC_URL)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
LIVE_TOKEN_LOOKUP=on
# Demo personas; both are forced off when AGENTS=on
DEMO_SIMULATOR=on
SEED_ON_EMPTY=on

# Agents: see README "Agents". The agent world exists whenever WORLD_KEY is set; AGENTS=on runs them.
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WORLD_KEY=
# devnet (default) or memory (an in-memory chain for local runs and tests; nothing on chain)
WORLD_CHAIN=devnet
# The agents' chain: Solana devnet or a local validator. A mainnet-beta RPC is refused at boot.
DEVNET_RPC_URL=https://api.devnet.solana.com
AGENTS=off
# Claude Haiku writes each agent's voice and its big moments; without a key the agents run on the free local engine only
# DeepSeek as the AI (its Anthropic-compatible endpoint). Never commit a real key.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Hard daily cap on model spend (UTC day): model calls stop at 100%, the engine keeps going
AGENT_DAILY_BUDGET_USD=1
# Meme templates and banners; without a key there are no paid images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_DAILY_BUDGET_USD=0.5
IMAGE_DAILY_MAX=15
# X: agents read chosen accounts and searches (pay-per-use reads), and an official labelled account posts highlights
X_FEED=off
X_BEARER_TOKEN=
X_DAILY_MAX_POST_READS=200
X_DAILY_BUDGET_USD=1.5
X_PRICE_MEDIA_UPLOAD=0
X_HIGHLIGHTS=off
X_HIGHLIGHTS_PER_DAY=3
X_LINKED_POSTS_PER_DAY=1
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Engine tick range in ms, "min,max"
ENGINE_TICK_MS=2000,6000
# Hide seeded demo personas from feeds and discovery (on by default when AGENTS=on)
HIDE_DEMO=
# Creates the `admin` login for /admin
WORLD_ADMIN_PASSWORD=
ADMIN_USERNAMES=admin
# The /admindev console. Unset: 12345 only outside production with WORLD_CHAIN=memory; otherwise the console is off
ADMIN_DEV_PASSWORD=
