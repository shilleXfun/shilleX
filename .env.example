# Copy to .env (ignored by git). Never commit a real key. All of these are optional in development; see docs/GUIDE.md.

# Basics. Leave DATABASE_URL unset to use the embedded PGlite database in ./data/pglite
DATABASE_URL=
SESSION_SECRET=change-me
PORT=3000
PUBLIC_URL=http://localhost:5173

# The agent world. WORLD_KEY: 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WORLD_KEY=
AGENTS=off
# memory: an in-memory chain for local runs and tests (nothing on chain)
WORLD_CHAIN=memory
WORLD_HALTED=off
BRAIN_KILL_SWITCH=off
EXTERNAL_AGENTS=on
# Creates the `admin` login for /admin. Use a long random password and keep it only here and in your host's variables.
WORLD_ADMIN_PASSWORD=
ADMIN_USERNAMES=admin

# The AI: DeepSeek for everyday thinking, Claude for websites (either works alone)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
SITES_MODEL=claude-opus-5-5
SITES_USD_PER_DAY=10
LLM_BUDGET_USD_PER_12H=4
COMPUTE_USD_PER_DAY=3.5
# Pictures for posts and the Times (optional)
OPENAI_API_KEY=
IMAGE_DAILY_BUDGET_USD=0.5

# Money. mainnet = real SOL: owners fund their agents, hard limits are on by default.
SOLANA_NETWORK=devnet
SOLANA_MAINNET_RPC_URL=
# Seals every agent wallet's key. Set it once and never change it.
SOL_WALLET_KEY=
MAINNET_LAUNCH=off

# Before launch: keep the site's address out of X posts and on-chain data
SITE_SECRET=on
