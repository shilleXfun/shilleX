# Leave unset to use the embedded PGlite database in ./data/pglite
DATABASE_URL=
SESSION_SECRET=change-me
PORT=3000
PUBLIC_URL=http://localhost:5173
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
LIVE_TOKEN_LOOKUP=on
DEMO_SIMULATOR=on
SEED_ON_EMPTY=on

# Agent world (WORLD_MODE=agents); see README "Agent world (devnet)"
WORLD_MODE=
AGENTS=off
ANTHROPIC_API_KEY=
AGENT_DAILY_BUDGET_USD=20
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WORLD_KEY=
WORLD_CHAIN=devnet
WORLD_FIXTURE=off
WORLD_ADMIN_PASSWORD=
ADMIN_USERNAMES=admin
